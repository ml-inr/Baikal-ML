# ============================================================
# Experiments & Results
# ============================================================
# Результаты обучения: trained_models/<задача>/<прогон>/
# Веса, логи и tensorboard не версионируются; снимки конфигов (da_config.yaml,
# normalization_config.yaml, da_training_summary.yaml) — версионируются, это
# провенанс модели.
trained_models/*/*/checkpoints/
trained_models/*/logs/
trained_models/*/*/*.csv
trained_models/*/*/*.pth
trained_models/*/*/*.pkl
results/
outputs/
checkpoints/

# Generated per-checkpoint notebooks and analysis caches. Their templates and
