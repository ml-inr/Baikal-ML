# small and make the bundle reproducible.
!trained_models/angle_track_uncertainty/release_v3/angle_norm.h5
!trained_models/angle_track_uncertainty/release_v3/classifier_norm.h5
!trained_models/angle_track_uncertainty/release_v3/independent_2019_f_metrics.json
!trained_models/angle_track_uncertainty/release_v3/reco_2020_comparison.json

