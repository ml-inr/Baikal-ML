# ============================================================
# Project Assets (configs, scripts, images — tracked selectively)
# ============================================================
*.json
*.txt
*.csv
*.png

# Архив: default-deny. По умолчанию НЕ отслеживается ничего —
# любой файл данных, положенный сюда, останется вне git независимо от
# расширения. Отслеживаются только исходники, конфиги и документация.
**/archive/**
!**/archive/**/
!**/archive/**/*.py
!**/archive/**/*.sh
!**/archive/**/*.yaml
!**/archive/**/*.yml
!**/archive/**/*.md
!**/archive/**/*.ipynb

# Отслеживаемый архив: код, выведенный из активного дерева, но сохраняемый
# в истории (см. doc/AUDIT.md §8.2). Тот же default-deny, что и для archive/:
# данные сюда не попадут даже при расширении, для которого нет отдельного
# правила (.dat, .wout, .tar, .bin). Без ведущего **/ — это один каталог в корне.
archive_tracked/**
!archive_tracked/**/
!archive_tracked/**/*.py
!archive_tracked/**/*.sh
!archive_tracked/**/*.yaml
!archive_tracked/**/*.yml
!archive_tracked/**/*.md
!archive_tracked/**/*.ipynb
scratch/
temp/
tmp/

# ============================================================
# Signal/Noise Models — keep only the canonical model
# ============================================================
# Moved from gplotnikov_sig_noise_models/ to trained_models/sig_noise/.
# All model variants except k_nsol_labelneq0_da_hs128_k0p0001 are excluded.
trained_models/sig_noise/archive/
trained_models/sig_noise/encoder_nl5_nh1_dff512_hs512_bs128/
trained_models/sig_noise/k_nsol_labelneq0_da_hs128/
trained_models/sig_noise/k_nsol_labelneq0_da_hs128_k0p001/
trained_models/sig_noise/k_nsol_labelneq0_hs512_dff512/
trained_models/sig_noise/logs/
trained_models/sig_noise/test.ipynb

# Allow the model config and README for the canonical model
!trained_models/sig_noise/k_nsol_labelneq0_da_hs128_k0p0001/train_config_mc_2020.yaml
!trained_models/sig_noise/k_nsol_labelneq0_da_hs128_k0p0001/README.md

